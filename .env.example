# Postgres connection string. On Supabase use the pooled "Transaction" string
# (Project Settings -> Database -> Connection string), port 6543.
DATABASE_URL=

# Public address of the site, no trailing slash (used when registering the bot).
APP_URL=http://localhost:3000

# Long random string. Protects /api/cron/cleanup and /api/telegram/register.
CRON_SECRET=

# Opens /stats and /api/stats (a long random string, different from CRON_SECRET).
ADMIN_SECRET=

# AI listener. Without a key nobody is answered automatically: people wait for a real listener.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Telegram bot (from @BotFather). The secret is any long random string.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional: instant delivery on the website through Supabase Realtime.
# Without these the site checks for new messages every 1.5 seconds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: one line with a verified local crisis line, shown on the help card.
HELPLINE_TEXT=
